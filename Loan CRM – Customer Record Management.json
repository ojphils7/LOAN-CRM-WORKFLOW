      "parameters": {
        "jsCode": "const input = $('Webhook').first().json.body;\nconst loan = $('Get many rows').first().json;\nconst customer = $('Get many rows1').first().json;\n\nif (!loan.id || !customer.id) {\n  return [{ json: { verified: false, reason: 'not_found' } }];\n}\n\nconst savedLast4 = String(customer.phone || '').replace(/\\D/g, '').slice(-4);\nconst sentLast4 = String(input.phone || '').replace(/\\D/g, '').slice(-4);\n\nif (!sentLast4 || savedLast4 !== sentLast4) {\n  return [{ json: { verified: false, reason: 'mismatch' } }];\n}\n\nconst today = new Date(); today.setHours(0, 0, 0, 0);\nconst daysOverdue = Math.max(0, Math.floor((today - new Date(loan.due_date)) / 86400000));\n\nreturn [{ json: {\n  verified: true,\n  customer_name: customer.full_name,\n  preferred_language: customer.preferred_language,\n  loan_code: loan.loan_code,\n  amount: loan.amount,\n  amount_paid: loan.amount_paid,\n  balance: loan.amount - loan.amount_paid,\n  due_date: loan.due_date,\n  days_overdue: daysOverdue,\n  status: loan.status\n} }];"
